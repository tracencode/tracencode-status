# Drop this into sites-available when nginx already owns ports 80 and 443.
# The status app listens on 127.0.0.1:8080.

server {
    listen 80;
    listen [::]:80;
    server_name status.tracencode.tech;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name status.tracencode.tech;

    # certbot --nginx -d status.tracencode.tech
    ssl_certificate     /etc/letsencrypt/live/status.tracencode.tech/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/status.tracencode.tech/privkey.pem;

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
